{
  "name": "obsidian-pin-tabs",
  "version": "0.1.0",
  "description": "Keep pinned tabs on the left in Obsidian Desktop.",
  "private": true,
  "main": "dist/pin-tabs-left/main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "build:vault": "npm run build && npm run deploy:vault",
    "check:release": "node scripts/check-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src eslint.config.mts --max-warnings 0",
    "deploy:vault": "node scripts/deploy-vault.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "0BSD",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
